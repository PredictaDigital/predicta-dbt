# Copy to .env (PowerShell: copy .env.example .env). Local dev only.
# Use letters and digits only: the init script substitutes these with sed.
CH_ADMIN_PASSWORD=LocalAdminPass1
CH_DBT_PASSWORD=LocalDbtPass1
CH_CUBE_PASSWORD=LocalCubePass1
# Set to false once you load real raw data
LOAD_SAMPLE_DATA=true
# MinIO (S3 API endpoint, not the web console). Use a read-only key.
MINIO_ENDPOINT=https://s3.example.com
MINIO_BUCKET=your-bucket
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
